/* pages/records/records.wxss */
.empty {
  margin-top: 120rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #ffffff;
  margin-top: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #8888aa;
  margin-top: 10rpx;
}

.avg-card {
  width: 100%;
  background: rgba(233, 69, 96, 0.12);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #e94560;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.record-list {
  width: 100%;
}

.record-item {
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.record-date {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.record-time {
  font-size: 26rpx;
  color: #a0a0c0;
  margin-top: 8rpx;
}

.record-duration {
  font-size: 30rpx;
  color: #e0e0e0;
  margin-top: 8rpx;
}

.record-status {
  align-self: flex-start;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

.record-status.good {
  background: rgba(100, 200, 100, 0.2);
  color: #64c864;
}

.record-status.ok {
  background: rgba(255, 200, 100, 0.2);
  color: #ffc864;
}

.record-status.bad {
  background: rgba(233, 69, 96, 0.2);
  color: #e94560;
}

.clear-btn {
  margin-top: 30rpx;
  color: #e94560;
}
