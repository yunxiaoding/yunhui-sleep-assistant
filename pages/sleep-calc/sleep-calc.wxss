/* pages/sleep-calc/sleep-calc.wxss */
.input-label {
  font-size: 30rpx;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.picker-row {
  display: flex;
  margin-bottom: 10rpx;
}

.picker-box {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #ffffff;
  margin-right: 20rpx;
}

.picker-box:last-child {
  margin-right: 0;
}

.result-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 30rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 28rpx;
  color: #a0a0c0;
  margin-bottom: 20rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.result-cyc {
  font-size: 28rpx;
  color: #e0e0e0;
}

.result-time {
  font-size: 36rpx;
  font-weight: bold;
  color: #e94560;
}

.tip {
  font-size: 26rpx;
  color: #8888aa;
  text-align: center;
  margin-top: 10rpx;
}
