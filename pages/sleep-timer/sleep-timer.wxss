/* pages/sleep-timer/sleep-timer.wxss */
.timer-circle {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 40rpx auto;
}

.timer-circle.idle {
  background: rgba(255, 255, 255, 0.08);
  border: 4rpx solid rgba(255, 255, 255, 0.15);
}

.timer-circle.running {
  background: rgba(233, 69, 96, 0.15);
  border: 4rpx solid #e94560;
}

.timer-count {
  font-size: 56rpx;
  font-weight: bold;
  color: #e94560;
}

.timer-label {
  font-size: 30rpx;
  color: #ffffff;
  margin-top: 10rpx;
}

.timer-hint {
  font-size: 24rpx;
  color: #8888aa;
  margin-top: 6rpx;
}

.info-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: #8888aa;
}

.info-value {
  font-size: 28rpx;
  color: #ffffff;
}

.result-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.result-icon {
  font-size: 72rpx;
}

.result-duration {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 16rpx;
}

.result-eval {
  font-size: 28rpx;
  color: #e94560;
  margin-top: 10rpx;
}
