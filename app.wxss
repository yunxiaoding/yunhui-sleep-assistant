/* app.wxss - 全局样式 */
page {
  background: linear-gradient(180deg, #0f3460 0%, #16213e 100%);
  color: #e0e0e0;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  min-height: 100vh;
}

.container {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #a0a0c0;
  margin-bottom: 40rpx;
}

/* 通用卡片样式 */
.card {
  width: 100%;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* 通用按钮 */
.btn-primary {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  background: linear-gradient(135deg, #e94560, #e94560);
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 45rpx;
  border: none;
  margin-top: 20rpx;
}

.btn-primary[disabled] {
  background: rgba(233, 69, 96, 0.4);
  color: rgba(255, 255, 255, 0.6);
}

.btn-secondary {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.1);
  color: #e0e0e0;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  margin-top: 16rpx;
}
